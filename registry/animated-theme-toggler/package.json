{
  "name": "@hyjkblj/animated-theme-toggler",
  "version": "0.1.0",
  "description": "带 View Transitions 形变动画的主题切换按钮（circle / 多边形 / 星形）。仅 React，依赖 lucide-react。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "animated-theme-toggler.tsx",
    "README.md"
  ],
  "main": "./dist/animated-theme-toggler.js",
  "module": "./dist/animated-theme-toggler.js",
  "types": "./dist/animated-theme-toggler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/animated-theme-toggler.d.ts",
      "import": "./dist/animated-theme-toggler.js",
      "default": "./dist/animated-theme-toggler.js"
    },
    "./source": "./animated-theme-toggler.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.400"
  },
  "publishConfig": {
    "access": "public"
  }
}
