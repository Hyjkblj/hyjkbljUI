{
  "name": "@hyjkblj/button-stateful",
  "version": "0.1.0",
  "description": "带状态切换的按钮：idle / loading / success / error 之间用模糊淡入切换，宽度自适应。仅 React。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "button",
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/button-stateful.d.ts",
      "import": "./dist/button-stateful.js",
      "default": "./dist/button-stateful.js"
    },
    "./source": "./button/stateful.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=11",
    "lucide-react": ">=0.400"
  },
  "publishConfig": {
    "access": "public"
  }
}
