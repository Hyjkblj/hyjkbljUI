{
  "name": "@hyjkblj/canvas-text",
  "version": "0.1.0",
  "description": "用 canvas 合成模式把文字抠成彩色扫线。仅 React，零外部运行时依赖。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "canvas-text.tsx",
    "README.md"
  ],
  "main": "./dist/canvas-text.js",
  "module": "./dist/canvas-text.js",
  "types": "./dist/canvas-text.d.ts",
  "exports": {
    ".": {
      "types": "./dist/canvas-text.d.ts",
      "import": "./dist/canvas-text.js",
      "default": "./dist/canvas-text.js"
    },
    "./source": "./canvas-text.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
