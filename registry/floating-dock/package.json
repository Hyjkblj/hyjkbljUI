{
  "name": "@hyjkblj/floating-dock",
  "version": "0.1.0",
  "description": "macOS 风格 Dock，鼠标扫过按距离放大，窄屏切成弹出菜单。仅 React，依赖 motion 与 @tabler/icons-react。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "floating-dock.tsx",
    "README.md"
  ],
  "main": "./dist/floating-dock.js",
  "module": "./dist/floating-dock.js",
  "types": "./dist/floating-dock.d.ts",
  "exports": {
    ".": {
      "types": "./dist/floating-dock.d.ts",
      "import": "./dist/floating-dock.js",
      "default": "./dist/floating-dock.js"
    },
    "./source": "./floating-dock.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=11",
    "@tabler/icons-react": ">=3"
  },
  "publishConfig": {
    "access": "public"
  }
}
