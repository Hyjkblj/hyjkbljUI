{
  "name": "@hyjkblj/hero-video-dialog",
  "version": "0.1.0",
  "description": "缩略图点开成视频弹窗，7 种展开动画。仅 React，依赖 motion 与 lucide-react。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "hero-video-dialog.tsx",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/hero-video-dialog.d.ts",
      "import": "./dist/hero-video-dialog.js",
      "default": "./dist/hero-video-dialog.js"
    },
    "./source": "./hero-video-dialog.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=11",
    "lucide-react": ">=0.400"
  },
  "publishConfig": {
    "access": "public"
  }
}
