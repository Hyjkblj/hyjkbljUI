{
  "name": "@hyjkblj/liquid-glass",
  "version": "0.1.0",
  "description": "液态玻璃材质：SVG 位移滤镜 + 背景模糊，可拖动的玻璃片。仅 React，零运行时依赖。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "liquid-glass.tsx",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/liquid-glass.d.ts",
      "import": "./dist/liquid-glass.js",
      "default": "./dist/liquid-glass.js"
    },
    "./source": "./liquid-glass.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
