{
  "name": "@hyjkblj/merging-bubbles",
  "version": "0.1.0",
  "description": "两个图标泡靠近、融合、再分开的过渡动画。仅 React，零运行时依赖。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "merging-bubbles.tsx",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/merging-bubbles.d.ts",
      "import": "./dist/merging-bubbles.js",
      "default": "./dist/merging-bubbles.js"
    },
    "./source": "./merging-bubbles.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
