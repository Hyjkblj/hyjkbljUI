{
  "name": "@hyjkblj/overflow-actions",
  "version": "0.1.0",
  "description": "连体胶囊工具条：主操作常驻，点「更多」用弹簧展开次级操作。仅 React，依赖 motion 与 lucide-react。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "overflow-actions.tsx",
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/overflow-actions.d.ts",
      "import": "./dist/overflow-actions.js",
      "default": "./dist/overflow-actions.js"
    },
    "./source": "./overflow-actions.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=11",
    "lucide-react": ">=0.400"
  },
  "publishConfig": {
    "access": "public"
  }
}
