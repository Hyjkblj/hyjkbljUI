{
  "name": "@hyjkblj/select",
  "version": "0.1.0",
  "description": "可组合的动画下拉选择：面板从触发器弹出并分离，另有 morph 变体（触发器长成面板）。含可关闭的 Web Audio 音效。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "select.tsx",
    "select-morph.tsx",
    "lib",
    "menu",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js",
      "default": "./dist/select.js"
    },
    "./morph": {
      "types": "./dist/select-morph.d.ts",
      "import": "./dist/select-morph.js",
      "default": "./dist/select-morph.js"
    },
    "./source": "./select.tsx",
    "./source-morph": "./select-morph.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=11",
    "lucide-react": ">=0.400"
  },
  "publishConfig": {
    "access": "public"
  }
}
