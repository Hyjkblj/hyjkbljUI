{
  "name": "@hyjkblj/shared-layout-bg",
  "version": "0.1.0",
  "description": "列表 hover 高亮：一个胶囊在行间共享 layout 滑动，进出带模糊。仅 React，依赖 motion。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "shared-layout-bg.tsx",
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/shared-layout-bg.d.ts",
      "import": "./dist/shared-layout-bg.js",
      "default": "./dist/shared-layout-bg.js"
    },
    "./source": "./shared-layout-bg.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=11"
  },
  "publishConfig": {
    "access": "public"
