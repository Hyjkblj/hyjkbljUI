{
  "name": "@hyjkblj/skeleton",
  "version": "0.1.0",
  "description": "扫光式骨架屏占位块。仅 React，零运行时依赖，需要 Tailwind v4 主题变量。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skeleton.tsx",
    "README.md"
  ],
  "main": "./dist/skeleton.js",
  "module": "./dist/skeleton.js",
  "types": "./dist/skeleton.d.ts",
  "exports": {
    ".": {
      "types": "./dist/skeleton.d.ts",
      "import": "./dist/skeleton.js",
      "default": "./dist/skeleton.js"
    },
    "./source": "./skeleton.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
