{
  "name": "@hyjkblj/wave-reveal",
  "version": "0.1.0",
  "description": "彩色波纹转场：卡片朝按下的按钮收拢，波纹从按点扩散并弯曲画面。仅 React，依赖 motion。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "wave-reveal.tsx",
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/wave-reveal.d.ts",
      "import": "./dist/wave-reveal.js",
      "default": "./dist/wave-reveal.js"
    },
    "./source": "./wave-reveal.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm -w run build:pkgs",
    "prepublishOnly": "pnpm -w run build:pkgs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=11"
  },
  "publishConfig": {
    "access": "public"
  }
}
